DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/nexicode

JWT_SECRET_KEY=replace-with-a-random-secret-key

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Which model to use for live feedback: gpt | claude | deepseek
ACTIVE_MODEL=claude

# development = debug mode on, relaxed secret checks
# production  = debug mode off, refuses to start with placeholder secrets
FLASK_ENV=development

# Comma-separated list of frontend URLs allowed to call this API.
# In dev this is your Vite server. Add your real domain here once deployed.
FRONTEND_URL=http://localhost:5173